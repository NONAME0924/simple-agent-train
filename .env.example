# 複製為 .env 後填寫自己的設定；不要上傳 .env。
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 必填：Ollama 已安裝的完整模型名稱。
DEFAULT_MODEL=
AGENT_CONTEXT_TOKENS=32768
AGENT_OUTPUT_TOKENS=4096
# 等待 Ollama 後續資料的逾時秒數；不是整個任務的時間上限。
AGENT_MODEL_READ_TIMEOUT=600
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Blender 插件的本機 Socket；不是 MCP HTTP 網址。
BLENDER_HOST=127.0.0.1
BLENDER_PORT=9876
