# 複製為 .env 後填寫自己的設定；不要上傳 .env。
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 必填：Ollama 已安裝的完整模型名稱。
DEFAULT_MODEL=
AGENT_CONTEXT_TOKENS=32768
AGENT_OUTPUT_TOKENS=4096
# 等待 Ollama 後續資料的逾時秒數；不是整個任務的時間上限。
AGENT_MODEL_READ_TIMEOUT=600
# 每次任務的主模型決策輪數；未結案時另加一次統整。
AGENT_MAX_STEPS=15
# 預設只開本機。要開放給同網路（例如實驗室）使用，改成 0.0.0.0，並確認防火牆只對內網放行。
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# 管理員帳號：第一次啟動、資料庫還沒有管理員時建立。兩者留空則自動建立 admin，
# 隨機密碼只在啟動視窗顯示一次。已存在管理員後這兩項不再生效，也不會覆蓋密碼。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 登入有效天數。
AUTH_SESSION_DAYS=7
# 前面有 HTTPS（反向代理）時設為 1，Cookie 才會加上 Secure；純 http 內網請維持 0。
AUTH_COOKIE_SECURE=0

